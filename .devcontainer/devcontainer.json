{
  "name": "NExtIMS 1.1 (no BDE)",
  "build": {
    "dockerfile": "Dockerfile",
    "context": ".."
  },
  "runArgs": [
    "--gpus=all",
    "--shm-size=1gb"
  ],
  "workspaceMount": "source=${localWorkspaceFolder},target=/workspace,type=bind",
  "workspaceFolder": "/workspace",
  "remoteUser": "devuser",
  "postCreateCommand": "python -m pip install --no-deps -e .",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance"
      ],
      "settings": {
        "python.defaultInterpreterPath": "/opt/venv/bin/python",
        "files.watcherExclude": {
          "**/data/**": true,
          "**/paper_runs/**": true
        },
        "search.exclude": {
          "**/data/**": true,
          "**/paper_runs/**": true
        }
      }
    }
  }
}
